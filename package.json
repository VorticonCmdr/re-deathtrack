{
 "name": "deathtrack-port",
 "version": "0.1.0",
 "private": true,
 "type": "module",
 "scripts": {
  "dev": "vite --host 127.0.0.1",
  "build": "vite build",
  "preview": "vite preview --host 127.0.0.1",
  "audit:assets": "node scripts/audit-assets.mjs",
  "verify:assets": "node scripts/verify-assets.mjs",
  "unpack:exe": "node scripts/unexepack.mjs game/DTRACK.EXE .local/re/DTRACK_U.EXE",
  "test": "node --test tests/",
  "verify": "node scripts/verify.mjs",
  "verify:browser": "node tests/browser/acceptance.mjs && node tests/browser/sound.mjs && ACCEPT_QUERY='?video=cga' node tests/browser/acceptance.mjs",
  "vehicle:studio": "vite --host 127.0.0.1 --port 5188 --strictPort",
  "vehicle:mcp": "node server/vehicle-mcp.mjs",
  "vehicle:tool": "node scripts/vehicle-tool.mjs"
 },
 "devDependencies": {
  "puppeteer-core": "^23.11.1",
  "vite": "^7.1.0"
 },
 "dependencies": {
  "@babylonjs/core": "^9.32.0",
  "@modelcontextprotocol/sdk": "^1.32.2",
  "zod": "^4.6.7"
 }
}
